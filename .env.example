# === App ===
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Mercado Pago ===
MP_ACCESS_TOKEN=APP_USR-...
MP_OAUTH_CLIENT_ID=tu_client_id
MP_OAUTH_CLIENT_SECRET=tu_client_secret
MP_OAUTH_STATE_SECRET=una_clave_larga_y_aleatoria
MP_WEBHOOK_SECRET=un_secreto_para_hmac
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-...

# === Staff Invites ===
# Secreto para firmar tokens de invitacion de personal. Si no se configura,
# se genera uno automatico que invalida invites pendientes al reiniciar.
STAFF_INVITE_SECRET=un_secreto_largo_y_aleatorio

# === Cron ===
CRON_SECRET=un_secreto_largo_y_aleatorio_para_cron

# === Upstash (rate limiting distribuido) ===
# Se requiere para rate limiting en produccion (Vercel). Sin estas variables,
# se usa rate limiting en memoria (no funciona en multi-instancia).
# Crear una base Redis gratis en https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# === reCAPTCHA (bot protection) ===
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6L...
# RECAPTCHA_SECRET_KEY=6L...

# === Resend (email) ===
RESEND_API_KEY=re_...

# === Google Analytics (opcional) ===
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# === Sentry ===
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
